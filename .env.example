# Django Settings
SECRET_KEY=your-secret-key-here-change-in-production
DEBUG=True
ALLOWED_HOSTS=localhost,127.0.0.1

# Database Settings
DB_NAME=stripe_shop
DB_USER=postgres
DB_PASSWORD=postgres
DB_HOST=db
DB_PORT=5432

# Stripe API Keys
STRIPE_PUBLIC_KEY=pk_test_your_stripe_public_key_here
STRIPE_SECRET_KEY=sk_test_your_stripe_secret_key_here

# Stripe API Keys for USD (optional, for multi-currency support)
STRIPE_PUBLIC_KEY_USD=pk_test_your_stripe_public_key_usd_here
STRIPE_SECRET_KEY_USD=sk_test_your_stripe_secret_key_usd_here

# Django Superuser (for admin panel)
DJANGO_SUPERUSER_USERNAME=admin
DJANGO_SUPERUSER_EMAIL=admin@example.com
DJANGO_SUPERUSER_PASSWORD=admin123
